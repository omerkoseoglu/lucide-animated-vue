{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "roller-coaster",
  "type": "registry:component",
  "title": "RollerCoasterIcon",
  "description": "Animated \"roller-coaster\" icon for Vue, built with motion-v.",
