{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "washing-machine",
  "type": "registry:component",
  "title": "WashingMachineIcon",
  "description": "Animated \"washing-machine\" icon, ported from pqoqubbw/icons.",
  "dependencies": [
