{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "downvote",
  "type": "registry:component",
  "title": "DownvoteIcon",
  "description": "Animated \"downvote\" icon, ported from pqoqubbw/icons.",
  "dependencies": [
