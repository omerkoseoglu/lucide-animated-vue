{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "figma",
  "type": "registry:component",
  "title": "FigmaIcon",
  "description": "Animated \"figma\" icon for Vue, built with motion-v.",
  "dependencies": [
    "motion-v"
