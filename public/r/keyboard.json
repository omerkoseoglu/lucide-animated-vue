{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "keyboard",
  "type": "registry:component",
  "title": "KeyboardIcon",
  "description": "Animated \"keyboard\" icon for Vue, built with motion-v.",
  "dependencies": [
    "motion-v"
  ],
  "files": [
    {
      "path": "components/icons/KeyboardIcon.vue",
      "content": "<script setup lang=\"ts\">\nimport { AnimatePresence, motion, useAnimationControls } from \"motion-v\";\nimport { ref, watch } from \"vue\";\n\ninterface Props {\n  size?: number;\n}\n\nwithDefaults(defineProps<Props>(), { size: 28 });\n\nconst KEYBOARD_PATHS = [\n  { id: \"key1\", d: \"M10 8h.01\" },\n  { id: \"key2\", d: \"M12 12h.01\" },\n  { id: \"key3\", d: \"M14 8h.01\" },\n  { id: \"key4\", d: \"M16 12h.01\" },\n  { id: \"key5\", d: \"M18 8h.01\" },\n  { id: \"key6\", d: \"M6 8h.01\" },\n  { id: \"key7\", d: \"M7 16h10\" },\n  { id: \"key8\", d: \"M8 12h.01\" },\n];\n\nconst isHovered = ref(false);\nconst controls = useAnimationControls();\nconst isControlled = ref(false);\n\nfunction startAnimation() {\n  isControlled.value = true;\n  isHovered.value = true;\n}\n\nfunction stopAnimation() {\n  isControlled.value = true;\n  isHovered.value = false;\n}\n\ndefineExpose({ startAnimation, stopAnimation });\n\nfunction handleMouseEnter() {\n  if (!isControlled.value) isHovered.value = true;\n}\n\nfunction handleMouseLeave() {\n  if (!isControlled.value) isHovered.value = false;\n}\n\nwatch(isHovered, async (hovered) => {\n  if (hovered) {\n    await controls.start((i: number) => ({\n      opacity: [1, 0.2, 1],\n      transition: {\n        duration: 1.5,\n        times: [0, 0.5, 1],\n        delay: i * 0.2 * Math.random(),\n        repeat: 1,\n        repeatType: \"reverse\",\n      },\n    }));\n  } else {\n    controls.stop();\n    controls.set({ opacity: 1 });\n  }\n});\n</script>\n\n<template>\n  <div @mouseenter=\"handleMouseEnter\" @mouseleave=\"handleMouseLeave\">\n    <svg\n      fill=\"none\"\n      :height=\"size\"\n      stroke=\"currentColor\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n      stroke-width=\"2\"\n      viewBox=\"0 0 24 24\"\n      :width=\"size\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n    >\n      <rect height=\"16\" rx=\"2\" width=\"20\" x=\"2\" y=\"4\" />\n      <AnimatePresence>\n        <motion.path\n          v-for=\"(path, index) in KEYBOARD_PATHS\"\n          :key=\"path.id\"\n          :animate=\"controls\"\n          :custom=\"index\"\n          :d=\"path.d\"\n          :initial=\"{ opacity: 1 }\"\n        />\n      </AnimatePresence>\n    </svg>\n  </div>\n</template>\n",
      "type": "registry:component",
      "target": "components/icons/KeyboardIcon.vue"
    }
  ]
}
