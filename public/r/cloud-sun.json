{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "cloud-sun",
  "type": "registry:component",
  "title": "CloudSunIcon",
  "description": "Animated \"cloud-sun\" icon for Vue, built with motion-v.",
  "dependencies": [
    "motion-v"
