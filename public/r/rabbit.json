{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "rabbit",
  "type": "registry:component",
  "title": "RabbitIcon",
  "description": "Animated \"rabbit\" icon, ported from pqoqubbw/icons.",
  "dependencies": [
    "motion-v"
