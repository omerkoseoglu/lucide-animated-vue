{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "git-commit-horizontal",
  "type": "registry:component",
  "title": "GitCommitHorizontalIcon",
  "description": "Animated \"git-commit-horizontal\" icon, ported from pqoqubbw/icons.",
  "dependencies": [
    "motion-v"
  ],
  "files": [
    {
      "path": "components/icons/GitCommitHorizontalIcon.vue",
      "content": "<script setup lang=\"ts\">\nimport type { Variants } from \"motion-v\";\nimport { motion, useAnimationControls } from \"motion-v\";\nimport { ref } from \"vue\";\n\ninterface Props {\n  size?: number;\n}\n\nwithDefaults(defineProps<Props>(), { size: 28 });\n\nconst VARIANTS: Variants = {\n  normal: {\n    pathLength: 1,\n    opacity: 1,\n  },\n  animate: (custom: number) => ({\n    pathLength: [0, 1],\n    opacity: [0, 1],\n    transition: {\n      delay: 0.15 * custom,\n      opacity: { delay: 0.1 * custom },\n    },\n  }),\n};\n\nconst controls = useAnimationControls();\nconst isControlled = ref(false);\n\nfunction startAnimation() {\n  isControlled.value = true;\n  controls.start(\"animate\");\n}\n\nfunction stopAnimation() {\n  isControlled.value = true;\n  controls.start(\"normal\");\n}\n\ndefineExpose({ startAnimation, stopAnimation });\n\nfunction handleMouseEnter() {\n  if (!isControlled.value) {\n    controls.start(\"animate\");\n  }\n}\n\nfunction handleMouseLeave() {\n  if (!isControlled.value) {\n    controls.start(\"normal\");\n  }\n}\n</script>\n\n<template>\n  <div @mouseenter=\"handleMouseEnter\" @mouseleave=\"handleMouseLeave\">\n    <svg\n      fill=\"none\"\n      :height=\"size\"\n      stroke=\"currentColor\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n      stroke-width=\"2\"\n      viewBox=\"0 0 24 24\"\n      :width=\"size\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n    >\n      <motion.circle :animate=\"controls\" :custom=\"1\" cx=\"12\" cy=\"12\" r=\"3\" :variants=\"VARIANTS\" />\n      <motion.line\n        :animate=\"controls\"\n        :custom=\"0\"\n        :variants=\"VARIANTS\"\n        x1=\"3\"\n        x2=\"9\"\n        y1=\"12\"\n        y2=\"12\"\n      />\n      <motion.line\n        :animate=\"controls\"\n        :custom=\"2\"\n        :variants=\"VARIANTS\"\n        x1=\"15\"\n        x2=\"21\"\n        y1=\"12\"\n        y2=\"12\"\n      />\n    </svg>\n  </div>\n</template>\n",
      "type": "registry:component",
      "target": "components/icons/GitCommitHorizontalIcon.vue"
    }
  ]
}
