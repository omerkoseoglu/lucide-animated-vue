{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "chevron-first",
  "type": "registry:component",
  "title": "ChevronFirstIcon",
  "description": "Animated \"chevron-first\" icon for Vue, built with motion-v.",
  "dependencies": [
