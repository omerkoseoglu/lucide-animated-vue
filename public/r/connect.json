{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "connect",
  "type": "registry:component",
  "title": "ConnectIcon",
  "description": "Animated \"connect\" icon, ported from pqoqubbw/icons.",
  "dependencies": [
