{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "history",
  "type": "registry:component",
  "title": "HistoryIcon",
  "description": "Animated \"history\" icon, ported from pqoqubbw/icons.",
  "dependencies": [
    "motion-v"
