{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "chart-scatter",
  "type": "registry:component",
  "title": "ChartScatterIcon",
  "description": "Animated \"chart-scatter\" icon, ported from pqoqubbw/icons.",
  "dependencies": [
