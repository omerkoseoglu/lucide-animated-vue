{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "circle-dashed",
  "type": "registry:component",
  "title": "CircleDashedIcon",
  "description": "Animated \"circle-dashed\" icon for Vue, built with motion-v.",
