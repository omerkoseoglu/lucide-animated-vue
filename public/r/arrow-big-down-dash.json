{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "arrow-big-down-dash",
  "type": "registry:component",
  "title": "ArrowBigDownDashIcon",
  "description": "Animated \"arrow-big-down-dash\" icon, ported from pqoqubbw/icons.",
  "dependencies": [
