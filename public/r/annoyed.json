{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "annoyed",
  "type": "registry:component",
  "title": "AnnoyedIcon",
  "description": "Animated \"annoyed\" icon, ported from pqoqubbw/icons.",
  "dependencies": [
