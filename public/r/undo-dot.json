{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "undo-dot",
  "type": "registry:component",
  "title": "UndoDotIcon",
  "description": "Animated \"undo-dot\" icon, ported from pqoqubbw/icons.",
  "dependencies": [
