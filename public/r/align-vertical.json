{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "align-vertical",
  "type": "registry:component",
  "title": "AlignVerticalIcon",
  "description": "Animated \"align-vertical\" icon for Vue, built with motion-v.",
  "dependencies": [
