{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "square-arrow-up",
  "type": "registry:component",
  "title": "SquareArrowUpIcon",
  "description": "Animated \"square-arrow-up\" icon, ported from pqoqubbw/icons.",
