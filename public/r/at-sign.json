{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "at-sign",
  "type": "registry:component",
  "title": "AtSignIcon",
  "description": "Animated \"at-sign\" icon, ported from pqoqubbw/icons.",
  "dependencies": [
