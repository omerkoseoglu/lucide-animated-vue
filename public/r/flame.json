{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "flame",
  "type": "registry:component",
  "title": "FlameIcon",
  "description": "Animated \"flame\" icon, ported from pqoqubbw/icons.",
  "dependencies": [
