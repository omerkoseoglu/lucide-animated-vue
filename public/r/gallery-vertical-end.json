{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "gallery-vertical-end",
  "type": "registry:component",
  "title": "GalleryVerticalEndIcon",
  "description": "Animated \"gallery-vertical-end\" icon for Vue, built with motion-v.",
