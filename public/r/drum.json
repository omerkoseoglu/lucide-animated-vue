{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "drum",
  "type": "registry:component",
  "title": "DrumIcon",
  "description": "Animated \"drum\" icon for Vue, built with motion-v.",
  "dependencies": [
