  "files": [
    {
      "path": "components/icons/VolumeIcon.vue",
      "content": "<script setup lang=\"ts\">\nimport { AnimatePresence, motion } from \"motion-v\";\nimport { ref } from \"vue\";\n\ninterface Props {\n  size?: number;\n}\n\nwithDefaults(defineProps<Props>(), { size: 28 });\n\nconst isHovered = ref(false);\nconst isControlled = ref(false);\n\nfunction startAnimation() {\n  isControlled.value = true;\n  isHovered.value = true;\n}\n\nfunction stopAnimation() {\n  isControlled.value = true;\n  isHovered.value = false;\n}\n\ndefineExpose({ startAnimation, stopAnimation });\n\nfunction handleMouseEnter() {\n  if (!isControlled.value) isHovered.value = true;\n}\n\nfunction handleMouseLeave() {\n  if (!isControlled.value) isHovered.value = false;\n}\n</script>\n\n<template>\n  <div @mouseenter=\"handleMouseEnter\" @mouseleave=\"handleMouseLeave\">\n    <svg\n      fill=\"none\"\n      :height=\"size\"\n      stroke=\"currentColor\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n      stroke-width=\"2\"\n      viewBox=\"0 0 24 24\"\n      :width=\"size\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n    >\n      <path\n        d=\"M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z\"\n      />\n      <AnimatePresence :initial=\"false\" mode=\"wait\">\n        <motion.g v-if=\"isHovered\" key=\"volume-icon-active\">\n          <motion.path\n            :animate=\"{ opacity: 1, transition: { delay: 0.1 } }\"\n            d=\"M16 9a5 5 0 0 1 0 6\"\n            :exit=\"{ opacity: 0 }\"\n            :initial=\"{ opacity: 0 }\"\n          />\n          <motion.path\n            :animate=\"{ opacity: 1, transition: { delay: 0.2 } }\"\n            d=\"M19.364 18.364a9 9 0 0 0 0-12.728\"\n            :exit=\"{ opacity: 0 }\"\n            :initial=\"{ opacity: 0 }\"\n          />\n        </motion.g>\n        <motion.g v-else key=\"volume-icon-inactive\">\n          <motion.line\n            :animate=\"{ pathLength: [0, 1], opacity: [0, 1], transition: { delay: 0.1 } }\"\n            :exit=\"{ pathLength: 1, opacity: 1 }\"\n            :initial=\"{ pathLength: 1, opacity: 1 }\"\n            x1=\"22\"\n            x2=\"16\"\n            y1=\"9\"\n            y2=\"15\"\n          />\n          <motion.line\n            :animate=\"{ pathLength: [0, 1], opacity: [0, 1], transition: { delay: 0.2 } }\"\n            :exit=\"{ pathLength: 1, opacity: 1 }\"\n            :initial=\"{ pathLength: 1, opacity: 1 }\"\n            x1=\"16\"\n            x2=\"22\"\n            y1=\"9\"\n            y2=\"15\"\n          />\n        </motion.g>\n      </AnimatePresence>\n    </svg>\n  </div>\n</template>\n",
      "type": "registry:component",
      "target": "components/icons/VolumeIcon.vue"
    }
  ]
