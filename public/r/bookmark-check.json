{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "bookmark-check",
  "type": "registry:component",
  "title": "BookmarkCheckIcon",
  "description": "Animated \"bookmark-check\" icon, ported from pqoqubbw/icons.",
