{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "switch-camera",
  "type": "registry:component",
  "title": "SwitchCameraIcon",
  "description": "Animated \"switch-camera\" icon for Vue, built with motion-v.",
  "dependencies": [
