{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "gallery-horizontal-end",
  "type": "registry:component",
  "title": "GalleryHorizontalEndIcon",
  "description": "Animated \"gallery-horizontal-end\" icon for Vue, built with motion-v.",
  "dependencies": [
    "motion-v"
